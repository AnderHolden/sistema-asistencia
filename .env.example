# ==============================================================================
# SISTEMA DE ASISTENCIA - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a `.env.local` para desarrollo local:
#   cp .env.example .env.local
#
# Para despliegue en Vercel:
#   Agrega estas variables en: Vercel Dashboard > Project > Settings > Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIGURATION (Públicas en el navegador)
# ------------------------------------------------------------------------------
# Obtén estos valores en: Firebase Console > Configuración del Proyecto > General > Tus apps > Web
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAJOKIzGTeDfdqEve1tvSN4m1PtDkcR7gc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sistema-asistencia-fb5f5.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sistema-asistencia-fb5f5
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sistema-asistencia-fb5f5.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=809785160456
NEXT_PUBLIC_FIREBASE_APP_ID=1:809785160456:web:490613b53adfc0586332bd

# ------------------------------------------------------------------------------
# 2. ROL SUPER ADMINISTRADOR POR DEFECTO
# ------------------------------------------------------------------------------
# El usuario con este correo obtendrá automáticamente permisos de super_admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@casitadetareas.com

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (Servidor / API Routes / Vercel Functions)
# ------------------------------------------------------------------------------
# Obtén la clave de cuenta de servicio en:
# Firebase Console > Configuración del Proyecto > Cuentas de Servicio > Generar nueva clave privada
#
# OPCIÓN A (Recomendada para Vercel):
# Pega el JSON completo en una sola línea o codificado en Base64 para evitar saltos de línea:
# En Linux/Mac/Git Bash: cat service-account.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"sistema-asistencia-fb5f5","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@sistema-asistencia-fb5f5.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# OPCIÓN B (Alternativa con variables individuales):
# FIREBASE_PROJECT_ID=sistema-asistencia-fb5f5
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@sistema-asistencia-fb5f5.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. NOTIFICACIONES POR CORREO (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
# Compatible con Gmail (Contraseña de aplicación), Resend, SendGrid, Amazon SES o cualquier SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@casitadetareas.com
SMTP_PASS=tu-contraseña-de-aplicacion-o-api-key
SMTP_FROM="Sistema de Asistencia <notificaciones@casitadetareas.com>"
